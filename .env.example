# Optional: override Wall of Love CTA URL (default is production URL in src/main.ts).
# VITE_WALL_OF_LOVE_URL=https://walloflove.since67.ca/

# Optional: Vite public base path.
# Defaults to ./ in vite.config.ts for GitHub Pages/static subpath safety.
# Use / only for root-domain deploys that require root-absolute asset URLs.
# VITE_BASE_PATH=./
